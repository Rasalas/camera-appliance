[Unit]
Description=Camera Appliance Docker Stack
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
RequiresMountsFor=/etc/camera-appliance /var/lib/camera-appliance

[Service]
Type=oneshot
WorkingDirectory=/opt/camera-appliance
Environment=COMPOSE_PROJECT_NAME=camera-appliance
ExecStart=/usr/bin/docker compose -f /opt/camera-appliance/compose.yaml up -d --build --remove-orphans
ExecReload=/usr/bin/docker compose -f /opt/camera-appliance/compose.yaml restart go2rtc camera-manager
ExecStop=/usr/bin/docker compose -f /opt/camera-appliance/compose.yaml down
RemainAfterExit=yes
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
