{
  "name": "camera-appliance-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test:embed": "node --test tests/embed-status.test.js",
    "test:mosaic": "node --test --experimental-strip-types src/pages/viewerMosaic.test.ts",
    "preview": "vite preview",
    "test:settings": "node --test --experimental-strip-types src/composables/settingsDraft.test.ts",
    "test:upload-crop": "node --test --experimental-strip-types src/composables/uploadCropDraft.test.ts",
    "test:upload-image": "node --test --experimental-strip-types src/composables/uploadImagePreview.test.ts",
    "test:updates": "node --test --experimental-strip-types src/composables/updateClient.test.ts",
    "test": "npm run test:updates && npm run test:embed && npm run test:mosaic && npm run test:settings && npm run test:upload-crop && npm run test:upload-image && npm run test:admin",
    "test:admin": "node --test --experimental-strip-types src/composables/adminSearch.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^5.6.3",
    "vite": "^8.0.16",
    "vue-tsc": "^2.1.10"
  }
}
