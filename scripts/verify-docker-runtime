#!/usr/bin/env bash
set -euo pipefail

# A disposable Docker daemon reproduces the customer's API >= 1.44 minimum.
# Nothing in this daemon uses appliance files, credentials or camera networks.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
run_id="camera-runtime-check-$$"
runtime_image="$run_id:runtime"
daemon="$run_id-daemon"
fixture="$(mktemp -d)"
cleanup() {
  docker rm -fv "$daemon" >/dev/null 2>&1 || true
  docker network rm "$run_id" >/dev/null 2>&1 || true
  docker image rm "$runtime_image" >/dev/null 2>&1 || true
  rm -rf "$fixture"
}
trap cleanup EXIT

docker build --target runtime -t "$runtime_image" -f "$ROOT/camera-manager/Dockerfile" "$ROOT"
docker network create "$run_id" >/dev/null
docker run --privileged -d --name "$daemon" --network "$run_id" --network-alias docker \
  -e DOCKER_TLS_CERTDIR= -v "$fixture:/fixture:ro" docker:29.2.1-dind >/dev/null
ready=0
for _ in {1..30}; do
  if docker exec "$daemon" docker info >/dev/null 2>&1; then ready=1; break; fi
  sleep 2
done
if [[ "$ready" != 1 ]]; then
  docker logs "$daemon"
  echo 'Disposable Docker daemon did not become ready.' >&2
  exit 1
fi

client() {
  docker run --rm --network "$run_id" -e DOCKER_HOST=tcp://docker:2375 \
    -v "$fixture:/fixture:ro" --entrypoint "$1" "$runtime_image" "${@:2}"
}

# This is the original failure: Debian's Docker 20.10 cannot negotiate with
# a daemon whose minimum API version is 1.44. The fixed runtime must succeed.
client docker version
client docker compose version
client docker-compose version

cat > "$fixture/Dockerfile" <<'DOCKERFILE'
FROM busybox:1.37.0
CMD ["sleep", "600"]
DOCKERFILE
cat > "$fixture/compose.yaml" <<'COMPOSE'
services:
  camera-manager:
    build: .
COMPOSE

# Verify buildx-backed Compose builds, actual recreation and both entrypoints
# used by the manager and its detached helper.
client docker compose -p runtime-check -f /fixture/compose.yaml up -d --build
before="$(client docker compose -p runtime-check -f /fixture/compose.yaml ps -q camera-manager)"
client docker inspect --type container --format '{{.Image}}' "$before"
client docker-compose -p runtime-check -f /fixture/compose.yaml up -d --build --force-recreate --remove-orphans
after="$(client docker compose -p runtime-check -f /fixture/compose.yaml ps -q camera-manager)"
[[ -n "$before" && -n "$after" && "$before" != "$after" ]]
client docker compose -p runtime-check -f /fixture/compose.yaml down
echo 'Docker API compatibility, image inspection and Compose recreation passed.'
